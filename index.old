 <!DOCTYPE html>
     2 <html lang="es">
     3 <head>
     4     <meta charset="UTF-8">
     5     <meta name="viewport" content="width=device-width, initial-scale=1.0">
     6     <title>Jump 25 Trading Bot - Deriv</title>
     7     <!-- Librería Lightweight Charts -->
     8     <script src="https://unpkg.com/lightweight-charts/dist/lightweight-charts.standalone.production.js"></script>
     9     <style>
    10         :root {
    11             --bg-color: #131722;
    12             --sidebar-bg: #1e222d;
    13             --border-color: #2a2e39;
    14             --text-color: #d1d4dc;
    15             --accent-color: #2962ff;
    16             --success: #089981;
    17             --danger: #f23645;
    18         }
    19
    20         body {
    21             margin: 0;
    22             padding: 0;
    23             background-color: var(--bg-color);
    24             color: var(--text-color);
    25             font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    26             display: flex;
    27             height: 100vh;
    28             overflow: hidden;
    29         }
    30
    31         /* Sidebar Styles */
    32         #sidebar {
    33             width: 320px;
    34             background-color: var(--sidebar-bg);
    35             border-right: 1px solid var(--border-color);
    36             display: flex;
    37             flex-direction: column;
    38             padding: 20px;
    39             box-sizing: border-box;
    40             z-index: 10;
    41             overflow-y: auto; /* Permite scroll si el contenido es largo */
    42         }
    43
    44         h2 { font-size: 1.2rem; margin-top: 0; color: #fff; }
    45
    46         .input-group { margin-bottom: 15px; }
    47         label { display: block; font-size: 11px; color: #b2b5be; text-transform: uppercase; margin-bottom: 5px; }
    48         
    49         input, select {
    50             width: 100%;
    51             background-color: #2a2e39;
    52             border: 1px solid #363c4e;
    53             color: #d1d4dc;
    54             padding: 10px;
    55             border-radius: 4px;
    56             box-sizing: border-box;
    57             outline: none;
    58             font-size: 14px;
    59         }
    60
    61         input:focus, select:focus { border-color: var(--accent-color); }
    62
    63         button {
    64             width: 100%;
    65             background-color: var(--accent-color);
    66             color: white;
    67             border: none;
    68             padding: 12px;
    69             border-radius: 4px;
    70             cursor: pointer;
    71             font-weight: bold;
    72             margin-top: 10px;
    73             transition: opacity 0.2s;
    74         }
    75
    76         button:hover { opacity: 0.9; }
    77
    78         /* Logs Viewer */
    79         #logs-container {
    80             flex-grow: 1;
    81             margin-top: 20px;
    82             background-color: #000;
    83             border: 1px solid var(--border-color);
    84             border-radius: 4px;
    85             padding: 10px;
    86             font-family: 'Consolas', 'Monaco', monospace;
    87             font-size: 12px;
    88             overflow-y: auto;
    89             color: #4ade80; /* Green terminal color */
    90             max-height: 200px; /* Limita la altura del contenedor de logs */
    91         }
    92
    93         .log-entry { margin-bottom: 6px; border-bottom: 1px solid #111; padding-bottom: 4px; line-height: 1.4; word-break: break-word; }
    94         .log-time { color: #888; font-size: 10px; }
    95         .signal-call { color: var(--success); font-weight: bold; }
    96         .signal-put { color: var(--danger); font-weight: bold; }
    97
    98         /* Main Content / Charts */
    99         #main-content {
   100             flex-grow: 1;
   101             display: flex;
   102             flex-direction: column;
   103             position: relative;
   104             overflow: hidden; /* Evita que los charts se desborden */
   105         }
   106
   107         #price-chart { flex: 2; position: relative; min-height: 300px; } /* Altura mínima para asegurar visibilidad */
   108         #rsi-chart { flex: 1; border-top: 2px solid var(--border-color); position: relative; min-height: 150px; } /* Altura mínima */
   109
   110         .chart-label {
   111             position: absolute;
   112             top: 10px;
   113             left: 10px;
   114             z-index: 5;
   115             background: rgba(30, 34, 45, 0.8);
   116             padding: 4px 8px;
   117             border-radius: 3px;
   118             font-size: 12px;
   119             pointer-events: none;
   120         }
   121     </style>
   122 </head>
   123 <body>
   124     <div id="sidebar">
   125         <h2>Deriv Jump 25 Bot</h2>
   126         
   127         <div class="input-group">
   128             <label for="api-token">API Token (Opcional)</label>
   129             <input type="password" id="api-token" placeholder="Tu token de Deriv...">
   130         </div>
   131
   132         <div class="input-group">
   133             <label for="app-id">App ID</label>
   134             <input type="text" id="app-id" value="1089" placeholder="Ej: 1089">
   135         </div>
   136
   137         <div class="input-group">
   138             <label for="timeframe">Temporalidad (Velas)</label>
   139             <select id="timeframe">
   140                 <option value="1">1 Segundo</option>
   141                 <option value="5">5 Segundos</option>
   142                 <option value="15">15 Segundos</option>
   143                 <option value="60" selected>1 Minuto</option>
   144                 <option value="300">5 Minutos</option>
   145                 <option value="900">15 Minutos</option>
   146             </select>
   147         </div>
   148
   149         <div style="margin-top: 15px; border-top: 1px solid var(--border-color); padding-top: 15px;">
   150             <label style="color: var(--accent-color); font-weight: bold;">Indicadores</label>
   151             <div style="display: flex; gap: 10px; margin-top: 10px;">
   152                 <div class="input-group" style="flex: 1;">
   153                     <label>SMA Period</label>
   154                     <input type="number" id="sma-period" value="23">
   155                 </div>
   156                 <div class="input-group" style="flex: 1;">
   157                     <label>EMA Period</label>
   158                     <input type="number" id="ema-period" value="10">
   159                 </div>
   160             </div>
   161             <div style="display: flex; gap: 10px;">
   162                 <div class="input-group" style="flex: 1;">
   163                     <label>RSI Period</label>
   164                     <input type="number" id="rsi-period" value="7">
   165                 </div>
   166                 <div class="input-group" style="flex: 1;">
   167                     <label>BB Period</label>
   168                     <input type="number" id="bb-period" value="20">
   169                 </div>
   170             </div>
   171             <div style="display: flex; gap: 10px;">
   172                 <div class="input-group" style="flex: 1;">
   173                     <label>RSI High</label>
   174                     <input type="number" id="rsi-high" value="65">
   175                 </div>
   176                 <div class="input-group" style="flex: 1;">
   177                     <label>RSI Low</label>
   178                     <input type="number" id="rsi-low" value="35">
   179                 </div>
   180             </div>
   181         </div>
   182
   183         <button id="start-btn">CONECTAR WEBSOCKET</button>
   184
   185         <div id="logs-container">
   186             <div class="log-entry">Sistema listo. Ingrese parámetros y conecte.</div>
   187         </div>
   188     </div>
   189
   190     <div id="main-content">
   191         <div id="price-chart">
   192             <div class="chart-label">JUMP 25 INDEX</div>
   193         </div>
   194         <div id="rsi-chart">
   195             <div class="chart-label">RSI</div>
   196         </div>
   197     </div>
   198
   199     <script>
   200         let priceChart, rsiChart;
   201         let candleSeries, smaSeries, emaSeries, rsiSeries;
   202         let bbUpperSeries, bbLowerSeries;
   203         let ws;
   204         let isConnected = false;
   205         let currentSymbol = 'R_25';
   206         let dataHistory = []; // Almacena velas {time, open, high, low, close}
   207         let lastRsiValue = null; // Para la lógica de pendiente
   208
   209         const chartOptions = {
   210             layout: { backgroundColor: '#131722', textColor: '#d1d4dc' },
   211             grid: { vertLines: { color: '#2a2e39' }, horzLines: { color: '#2a2e39' } },
   212             crosshair: { mode: LightweightCharts.CrosshairMode.Normal },
   213             rightPriceScale: { borderColor: '#2a2e39' },
   214             timeScale: { borderColor: '#2a2e39', timeVisible: true, secondsVisible: true },
   215         };
   216
   217         function initCharts() {
   218             const pContainer = document.getElementById('price-chart');
   219             const rContainer = document.getElementById('rsi-chart');
   220             // Limpiar si ya existen para evitar duplicados al reconectar
   221             pContainer.innerHTML = '<div class="chart-label">JUMP 25 INDEX</div>';
   222             rContainer.innerHTML = '<div class="chart-label">RSI</div>';
   223
   224             priceChart = LightweightCharts.createChart(pContainer, { ...chartOptions, height: pContainer.clientHeight });
   225             candleSeries = priceChart.addCandlestickSeries({
   226                 upColor: '#089981', downColor: '#f23645',
   227                 borderVisible: false, wickUpColor: '#089981', wickDownColor: '#f23645',
   228             });
   229             
   230             smaSeries = priceChart.addLineSeries({ color: '#2962ff', lineWidth: 2, title: 'SMA' });
   231             emaSeries = priceChart.addLineSeries({ color: '#f23645', lineWidth: 1, title: 'EMA' });
   232             bbUpperSeries = priceChart.addLineSeries({ color: 'rgba(255, 255, 255, 0.2)', lineWidth: 1, lineStyle: 2 });
   233             bbLowerSeries = priceChart.addLineSeries({ color: 'rgba(255, 255, 255, 0.2)', lineWidth: 1, lineStyle: 2 });
   234
   235             rsiChart = LightweightCharts.createChart(rContainer, { ...chartOptions, height: rContainer.clientHeight });
   236             rsiSeries = rsiChart.addLineSeries({ color: '#ff9800', lineWidth: 2, title: 'RSI' });
   237
   238             const highLevel = parseFloat(document.getElementById('rsi-high').value);
   239             const lowLevel = parseFloat(document.getElementById('rsi-low').value);
   240             rsiSeries.createPriceLine({ price: highLevel, color: '#f23645', lineWidth: 1, lineStyle: 2, axisLabelVisible: true, title: 'SOBRECOMPRA' });
   241             rsiSeries.createPriceLine({ price: lowLevel, color: '#089981', lineWidth: 1, lineStyle: 2, axisLabelVisible: true, title: 'SOBREVENTA' });
   242
   243             priceChart.timeScale().subscribeVisibleTimeRangeChange(range => rsiChart.timeScale().setVisibleRange(range));
   244             rsiChart.timeScale().subscribeVisibleTimeRangeChange(range => priceChart.timeScale().setVisibleRange(range));
   245             
   246             // Ajuste de tamaño al redimensionar ventana
   247             window.addEventListener('resize', () => {
   248                 priceChart.resize(pContainer.clientWidth, pContainer.clientHeight);
   249                 rsiChart.resize(rContainer.clientWidth, rContainer.clientHeight);
   250             });
   251         }
   252
   253         // --- CÁLCULOS DE INDICADORES ---
   254         function calculateSMA(data, period) {
   255             return data.map((d, i) => {
   256                 if (i < period - 1) return { time: d.time, value: null };
   257                 let sum = 0;
   258                 for (let j = 0; j < period; j++) sum += data[i - j].close;
   259                 return { time: d.time, value: sum / period };
   260             });
   261         }
   262
   263         function calculateEMA(data, period) {
   264             if (data.length === 0) return [];
   265             let k = 2 / (period + 1);
   266             let ema = data[0].close;
   267             return data.map(d => {
   268                 ema = (d.close - ema) * k + ema;
   269                 return { time: d.time, value: ema };
   270             });
   271         }
   272
   273         function calculateRSI(data, period) {
   274             let res = [];
   275             if(data.length < period + 1) return data.map(d => ({time: d.time, value: null}));
   276             
   277             for (let i = 0; i < data.length; i++) {
   278                 if (i < period) { res.push({ time: data[i].time, value: null }); continue; }
   279                 let gains = 0, losses = 0;
   280                 for (let j = i - period + 1; j <= i; j++) {
   281                     let diff = data[j].close - data[j - 1].close;
   282                     diff >= 0 ? gains += diff : losses -= diff;
   283                 }
   284                 let rs = gains / (losses || 1);
   285                 res.push({ time: data[i].time, value: 100 - (100 / (1 + rs)) });
   286             }
   287             return res;
   288         }
   289
   290         function calculateBB(data, period) {
   291             let upper = [], lower = [];
   292             data.forEach((d, i) => {
   293                 if (i < period - 1) { upper.push({ time: d.time, value: null }); lower.push({ time: d.time, value: null }); return; }
   294                 let sum = 0;
   295                 for (let j = 0; j < period; j++) sum += data[i - j].close;
   296                 let avg = sum / period;
   297                 let sqSum = 0;
   298                 for (let j = 0; j < period; j++) sqSum += Math.pow(data[i - j].close - avg, 2);
   299                 let sd = Math.sqrt(sqSum / period);
   300                 upper.push({ time: d.time, value: avg + sd * 2 });
   301                 lower.push({ time: d.time, value: avg - sd * 2 });
   302             });
   303             return { upper, lower };
   304         }
   305
   306         function updateIndicators() {
   307             if (dataHistory.length < 2) return;
   308             
   309             const smaP = parseInt(document.getElementById('sma-period').value);
   310             const emaP = parseInt(document.getElementById('ema-period').value);
   311             const rsiP = parseInt(document.getElementById('rsi-period').value);
   312             const bbP = parseInt(document.getElementById('bb-period').value);
   313
   314             smaSeries.setData(calculateSMA(dataHistory, smaP).filter(d => d.value !== null));
   315             emaSeries.setData(calculateEMA(dataHistory, emaP));
   316             const rsiData = calculateRSI(dataHistory, rsiP);
   317             rsiSeries.setData(rsiData.filter(d => d.value !== null));
   318             const bb = calculateBB(dataHistory, bbP);
   319             bbUpperSeries.setData(bb.upper.filter(d => d.value !== null));
   320             bbLowerSeries.setData(bb.lower.filter(d => d.value !== null));
   321
   322             // Paso 5: Señales
   323             if (rsiData.length >= 2) {
   324                 const currentRsi = rsiData[rsiData.length - 1].value;
   325                 const prevRsi = rsiData[rsiData.length - 2].value;
   326                 if (currentRsi !== null && prevRsi !== null) {
   327                     processSignals(currentRsi, prevRsi);
   328                 }
   329             }
   330         }
   331
   332         // --- WEBSOCKET Y CONEXIÓN ---
   333         const startBtn = document.getElementById('start-btn');
   334         startBtn.addEventListener('click', () => isConnected ? location.reload() : connect());
   335
   336         function connect() {
   337             const appId = document.getElementById('app-id').value || '1089';
   338             const token = document.getElementById('api-token').value;
   339             const granularity = parseInt(document.getElementById('timeframe').value);
   340
   341             ws = new WebSocket(`wss://ws.binaryws.com/websockets/v3?app_id=${appId}`);
   342
   343             ws.onopen = () => {
   344                 addLog('Conectado a Deriv. Solicitando historial (1 hora)...');
   345                 initCharts();
   346                 if (token) ws.send(JSON.stringify({ authorize: token })); else requestHistory();
   347             };
   348
   349             ws.onmessage = (msg) => {
   350                 const res = JSON.parse(msg.data);
   351                 
   352                 if (res.msg_type === 'authorize') {
   353                     if (res.error) addLog('Error de Token: ' + res.error.message, 'put');
   354                     else { addLog('Autorizado.'); requestHistory(); }
   355                 }
   356
   357                 // Manejo de Historial de Velas
   358                 if (res.msg_type === 'candles') {
   359                     dataHistory = res.candles.map(c => ({ time: c.epoch, open: c.open, high: c.high, low: c.low, close: c.close }));
   360                     candleSeries.setData(dataHistory);
   361                     updateIndicators(); // Calcular indicadores iniciales
   362                     subscribeOHLC();
   363                     isConnected = true;
   364                     startBtn.innerText = 'DESCONECTAR';
   365                 }
   366
   367                 // Manejo de Velas en Tiempo Real (msg_type: ohlc)
   368                 if (res.msg_type === 'ohlc') {
   369                     const o = res.ohlc;
   370                     const candle = { time: o.open_time, open: parseFloat(o.open), high: parseFloat(o.high), low: parseFloat(o.low), close: parseFloat(o.close) };
   371                     candleSeries.update(candle);
   372
   373                     // Actualizar nuestro array de datos
   374                     if (dataHistory.length > 0 && dataHistory[dataHistory.length - 1].time === candle.time)  {
   375                         dataHistory[dataHistory.length - 1] = candle; // Actualiza vela actual
   376                     } else {
   377                         dataHistory.push(candle);
   378                         if (dataHistory.length > 5000) dataHistory.shift(); // Limitar memoria
   379                     }
   380                     updateIndicators();
   381                 }
   382             };
   383
   384             ws.onclose = () => {
   385                 addLog('Conexión cerrada.', 'put');
   386                 isConnected = false;
   387                 startBtn.innerText = 'CONECTAR WEBSOCKET';
   388             };
   389         }
   390
   391         function requestHistory() {
   392             const gran = parseInt(document.getElementById('timeframe').value);
   393             const now = Math.floor(Date.now() / 1000);
   394             const oneHourAgo = now - 3600; // 1 hora en segundos
   395             
   396             ws.send(JSON.stringify({
   397                 ticks_history: currentSymbol,
   398                 end: 'latest',
   399                 start: oneHourAgo,
   400                 style: 'candles',
   401                 granularity: gran,
   402                 subscribe: 0 // Solo historial primero
   403             }));
   404         }
   405
   406         function subscribeOHLC() {
   407             const gran = parseInt(document.getElementById('timeframe').value);
   408             ws.send(JSON.stringify({ forget_all: 'ohlc' })); // Olvidar suscripciones previas
   409             ws.send(JSON.stringify({
   410                 ticks_history: currentSymbol,
   411                 subscribe: 1, // Suscribirse a updates
   412                 end: 'latest',
   413                 granularity: gran,
   414                 style: 'candles'
   415             }));
   416         }
   417
   418         // --- ESTRATEGIA DE SEÑALES ---
   419         function processSignals(currentRsi, prevRsi) {
   420             const rsiHigh = parseFloat(document.getElementById('rsi-high').value);
   421             const rsiLow = parseFloat(document.getElementById('rsi-low').value);
   422             let signal = null; // 'call' or 'put'
   423             let trend = '';
   424
   425             if (currentRsi > rsiHigh && currentRsi > prevRsi) {
   426                 signal = 'call';
   427                 trend = 'Subiendo (RSI > 65)';
   428             } else if (currentRsi < rsiLow && currentRsi < prevRsi) {
   429                 signal = 'put';
   430                 trend = 'Bajando (RSI < 35)';
   431             }
   432
   433             const logMsg = `RSI: ${currentRsi.toFixed(2)} | Prev: ${prevRsi.toFixed(2)} | Trend: ${trend}`;
   434             addLog(logMsg);
   435             
   436             // Dibujar marcador en el gráfico
   437             if (signal) {
   438                 const lastCandle = dataHistory[dataHistory.length - 1];
   439                 const markerColor = signal === 'call' ? '#089981' : '#f23645'; // Verde para Call, Rojo para Put
   440                 const markerText = signal === 'call' ? '▲' : '▼';
   441
   442                 candleSeries.createPriceLine({
   443                     price: lastCandle.high, // Posicionar sobre el máximo de la vela
   444                     color: markerColor,
   445                     lineWidth: 2,
   446                     lineStyle: LightweightCharts.LineStyle.Solid,
   447                     axisLabelVisible: false, // No mostrar label de precio
   448                     visible: true,
   449                     title: markerText // Usar texto como marcador simple
   450                 });
   451                 addLog(`¡SEÑAL DE ${signal.toUpperCase()} DETECTADA!`, signal);
   452             }
   453         }
   454
   455         // Inicialización inicial al cargar la página
   456         window.onload = () => {
   457             initCharts();
   458             // Ajustar tamaño inicial si es necesario
   459             window.dispatchEvent(new Event('resize'));
   460         };
   461     </script>
   462 </body>
   463 </html>
